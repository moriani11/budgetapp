<%- include("partials/header") %>

<header class="page-header">
    <h1>Uitgave bewerken</h1>
    <p>Pas de gegevens van de uitgave aan</p>
</header>

<section class="card">
    <form action="/expenses/<%= expense._id %>/update" method="POST" class="form">
        <div class="form__group">
            <label for="name" class="form__label">Omschrijving:</label>
            <input type="text" id="name" name="name" class="form__input" value="<%= expense.name %>" required>
        </div>

        <div class="form__group">
            <label for="amount" class="form__label">Bedrag (€):</label>
            <input type="number" step="0.01" id="amount" name="amount" class="form__input" value="<%= expense.amount %>" required>
        </div>

        <div class="form__group">
            <label for="categoryName" class="form__label">Categorie:</label>
            <select id="categoryName" name="categoryName" class="form__select" required>
                <% for (let cat of categories) { %>
                    <option value="<%= cat.name %>" <%= cat.name === expense.categoryName ? 'selected' : '' %>>
                        <%= cat.icon || '' %> <%= cat.name %>
                    </option>
                <% } %>
            </select>
        </div>

        <div class="form__group">
            <label for="date" class="form__label">Datum:</label>
            <% 
               let dateVal = "";
               if (expense.date) {
                   dateVal = new Date(expense.date).toISOString().slice(0, 10);
               }
            %>
            <input type="date" id="date" name="date" class="form__input" value="<%= dateVal %>" required>
        </div>

        <div class="form__group">
            <label class="form__checkbox">
                <input type="checkbox" id="recurring" name="recurring" <%= expense.recurring ? 'checked' : '' %>>
                <span>🔄 <strong>Vaste maandelijkse uitgave</strong> <small style="color: var(--text-muted); display: block; font-size: 0.8rem;">(Wordt automatisch elke maand van je inkomsten afgetrokken)</small></span>
            </label>
        </div>

        <div class="btn-group">
            <button type="submit" class="btn btn--primary">Bijwerken</button>
            <a href="/expenses" class="btn btn--ghost">Annuleren</a>
        </div>
    </form>
</section>

<%- include("partials/footer") %>
