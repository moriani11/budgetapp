<%- include("partials/header") %>

<header class="page-header">
    <h1>Inloggen</h1>
    <p>Meld je aan bij je BudgetApp account</p>
</header>

<section class="card" style="max-width: 420px; margin: 0 auto;">
    <% if (typeof message !== "undefined" && message) { %>
        <p class="<%= message.type %>">
            <%= message.message %>
        </p>
    <% } %>

    <form action="/login" method="POST" class="form">
        <div class="form__group">
            <label for="email" class="form__label">Email:</label>
            <input type="email" id="email" name="email" class="form__input" placeholder="admin@budgetapp.be" required>
        </div>

        <div class="form__group">
            <label for="password" class="form__label">Wachtwoord:</label>
            <input type="password" id="password" name="password" class="form__input" required>
        </div>

        <button type="submit" class="btn btn--primary" style="width: 100%;">Inloggen</button>
    </form>
</section>

<%- include("partials/footer") %>
