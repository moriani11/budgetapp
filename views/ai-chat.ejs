<%- include("partials/header") %>

<header class="page-header">
    <div>
        <h1>AI Financieel Advies</h1>
        <p>Stel vragen over je uitgaven en ontvang direct slimme besparingstips</p>
    </div>
</header>

<section class="card section">
    <form action="/ai-chat" method="POST" class="form" id="aiForm">
        <div class="form__group">
            <label for="month" class="form__label">Te analyseren maand:</label>
            <input type="month" id="month" name="month" class="form__input" value="<%= month %>" required>
        </div>

        <div class="form__group">
            <label for="question" class="form__label">Jouw vraag aan de AI:</label>
            <input type="text" id="question" name="question" class="form__input" value="<%= question %>" placeholder="bijv. Waar geef ik het meeste aan uit?" required>
        </div>

        <div class="form__group">
            <label class="form__label" style="font-size: 0.8125rem; color: var(--text-muted);">Of kies een snelle vraag:</label>
            <div class="btn-group" style="gap: 0.5rem;">
                <button type="button" class="btn btn--secondary btn--sm" onclick="setQuestion('Waar geef ik het meeste aan uit?')">🔍 Grootste uitgave</button>
                <button type="button" class="btn btn--secondary btn--sm" onclick="setQuestion('Kan ik een uitgave van 150 euro doen?')">�️ Mag ik €150 uitgeven?</button>
                <button type="button" class="btn btn--secondary btn--sm" onclick="setQuestion('Hoeveel geef ik uit aan voeding?')">🛒 Kosten voeding</button>
                <button type="button" class="btn btn--secondary btn--sm" onclick="setQuestion('Is mijn financiële buffer gezond?')">🛡️ Buffercheck</button>
                <button type="button" class="btn btn--secondary btn--sm" onclick="setQuestion('Hoe kan ik deze maand besparen?')">💡 Bespaartips</button>
            </div>
        </div>

        <button type="submit" class="btn btn--primary">
            <span>✨ Vraag advies</span>
        </button>
    </form>
</section>

<% if (answer) { %>
    <section class="card">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <span style="font-size: 1.25rem;">🤖</span>
            <h2 class="card__label" style="margin: 0;">Advies van Budget AI</h2>
        </div>
        <div class="chat__bubble chat__bubble--assistant" style="white-space: pre-line; line-height: 1.7; font-size: 0.95rem;">
            <%= answer %>
        </div>
    </section>
<% } %>

<script>
function setQuestion(text) {
    var input = document.getElementById('question');
    if (input) {
        input.value = text;
        document.getElementById('aiForm').submit();
    }
}
</script>

<%- include("partials/footer") %>
