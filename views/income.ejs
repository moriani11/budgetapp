<%- include("partials/header") %>

<header class="page-header">
    <h1>Inkomsten beheren</h1>
    <p>Stel je verwachte inkomsten in per maand</p>
</header>

<section class="card">
    <form action="/income" method="POST" class="form">
        <div class="form__group">
            <label for="month" class="form__label">Maand:</label>
            <input type="month" id="month" name="month" class="form__input" value="<%= month %>" required>
        </div>

        <div class="form__group">
            <label for="amount" class="form__label">Inkomsten (€):</label>
            <input type="number" step="0.01" id="amount" name="amount" class="form__input" value="<%= amount %>" placeholder="0.00" required>
        </div>

        <button type="submit" class="btn btn--primary">Opslaan</button>
    </form>
</section>

<%- include("partials/footer") %>
