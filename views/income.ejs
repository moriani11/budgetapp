<%- include("partials/header") %> 
 
<header class="page-header"> 
    <div> 
        <h1>Inkomen</h1> 
        <p>Overzicht van al je geregistreerde inkomsten</p> 
    </div> 
</header> 

<section class="card filter-bar">
    <form action="/income" method="GET" class="form form--inline">
        <label class="form__label" for="month">Kies maand:</label>
        <input class="form__input" type="month" id="month" name="month" value="<%= selectedMonth === 'all' ? '' : selectedMonth %>" onchange="this.form.submit()">
        <noscript><button type="submit" class="btn btn--secondary">Bekijk</button></noscript>
        <a href="/income?month=all" class="btn btn--ghost<%= selectedMonth === 'all' ? ' btn--active' : '' %>">Toon alles</a>
    </form>

    <div class="filter-bar__total filter-bar__total--income">
        <span class="filter-bar__total-label"><%= showAll ? 'Totaal alle maanden' : 'Totaal deze maand' %></span>
        <span class="filter-bar__total-value">+€<%= totalAmount.toFixed(2) %></span>
    </div>
</section>

<% if (showAll && monthlyTotals.length > 0) { %>
    <section class="card section">
        <h2 class="card__label" style="margin-bottom: 1rem;">Totaal per maand</h2>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Maand</th>
                        <th>Totaal</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let row of monthlyTotals) { %>
                        <tr>
                            <td><%= row.month %></td>
                            <td style="font-weight: 700; font-variant-numeric: tabular-nums; color: green;">+€<%= row.total.toFixed(2) %></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>
<% } %>

<section class="card">
    <div style="margin-bottom: 1rem;"> 
        <h2 class="card__label" style="margin: 0;">Overzicht inkomen</h2> 
    </div> 
 
    <% if (income.length === 0) { %> 
        <p style="color: var(--text-muted); font-size: 0.95rem;">
            Nog geen inkomsten geregistreerd.
        </p> 
    <% } else { %> 
        <div class="table-wrapper"> 
            <table class="table"> 
                <thead> 
                    <tr> 
                        <th>Naam</th> 
                        <th>Categorie</th> 
                        <th>Bedrag</th> 
                        <th>Datum</th> 
                    </tr> 
                </thead> 
                <tbody> 
                    <% for (let incomeItem of income) { %> 
                        <tr> 
                            <td>
                                <strong><%= incomeItem.name %></strong>
                            </td> 
                            <td>
                                <span class="badge badge--brand">
                                    <%= incomeItem.categoryName %>
                                </span>
                            </td> 
                            <td style="font-weight: 700; font-variant-numeric: tabular-nums; color : green">
                                +€<%= Number(incomeItem.amount).toFixed(2) %>
                            </td> 
                            <td style="color: var(--text-muted); font-size: 0.8125rem;">
                                <%= new Date(incomeItem.date).toLocaleDateString('nl-NL') %>
                            </td> 
                        </tr> 
                    <% } %> 
                </tbody> 
            </table> 
        </div> 
    <% } %> 
</section> 
 
<%- include("partials/footer") %>