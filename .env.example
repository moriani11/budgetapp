# Server Configuratie
PORT=3000
NODE_ENV=development

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017
# of MONGODB_URI=mongodb://localhost:27017

# Beveiliging & Authenticatie
SESSION_SECRET=vervang_dit_door_een_willekeurige_veilige_sleutel
ADMIN_EMAIL=admin@budgetapp.be
ADMIN_PASSWORD=admin123

# OpenAI API (voor de AI Budget Assistent)
OPENAI_API_KEY=sk-...

# Enable Banking API (PSD2 Live Bank Account Data)
# Verkrijgbaar via https://enablebanking.com (API Applications -> Production)
ENABLE_BANKING_APPLICATION_ID=
# De private key kan als PEM-string ingevoerd worden (met \n voor newlines) of als pad naar je private_key.pem bestand
ENABLE_BANKING_PRIVATE_KEY=
# Optioneel bestandspad indien de sleutel in een lokaal bestand staat:
ENABLE_BANKING_KEY_PATH=./private_key.pem
# Callback URL waar de bank na authenticatie naar terugkeert:
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/bank/callback
